# ============================================================
# VinStudio - Apache Configuration (.htaccess)
# ============================================================

# 1. Pastikan index.php dibuka pertama kali
DirectoryIndex index.php index.html

# 2. Matikan penampilan daftar isi direktori (Mencegah "Index of /")
Options -Indexes

# 3. Lindungi file sensitif & database dari download langsung
<FilesMatch "(\.env|\.sqlite|\.sql|\.db|\.log|\.err|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Lindungi file & folder tersembunyi (seperti .git, .github)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# 5. Charset default UTF-8
AddDefaultCharset UTF-8

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri Album - VinStudio</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .album-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .album-card {
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .album-img-wrap {
            position: relative;
            overflow: hidden;
            height: 200px;
            background: #0f172a;
        }
        .album-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }
        .album-card:hover .album-img-wrap img {
            transform: scale(1.06);
        }
        .album-stats-bar {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-top: 0.75rem;
            font-size: 0.8rem;
            color: var(--text-light);
        }
        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            background: var(--lighter);
            border: 1px solid var(--border);
            padding: 0.2rem 0.55rem;
            border-radius: var(--radius-pill);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">&#128248;</span>
                <span class="logo-text">VinStudio</span>
            </div>
            <%- include('partials/nav', { currentPage: 'albums', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <section class="gallery-page">
            <div class="container">
                <div class="page-header page-anim">
                    <div>
                        <h1>&#128248; Galeri Foto &amp; Album</h1>
                        <p class="page-subtitle">Dokumentasi momen, kegiatan, dan portofolio karya.</p>
                    </div>
                    <% if (locals.user) { %>
                        <a href="/albums/add" class="btn btn-primary">&#10133; Tambah Album Baru</a>
                    <% } else { %>
                        <a href="/login?r=/albums/add" class="btn btn-outline">Masuk untuk Menambah Album</a>
                    <% } %>
                </div>

                <!-- Toolbar Pencarian -->
                <div class="toolbar page-anim" style="margin-bottom:1.75rem;">
                    <div class="search-box">
                        <span class="search-icon">&#128269;</span>
                        <input type="search" id="albumSearch" placeholder="Cari judul album atau uploader..." aria-label="Cari album">
                    </div>
                    <span class="admin-hint" id="albumCountDisplay"><%= albums.length %> album tersedia</span>
                </div>

                <% if (albums.length > 0) { %>
                <div class="album-grid page-anim" id="albumsContainer">
                    <% albums.forEach(album => { %>
                    <article class="album-card" data-title="<%= (album.title + ' ' + (album.username || '')).toLowerCase() %>">
                        <a href="/albums/<%= album.id %>" class="album-link">
                            <div class="album-img-wrap">
                                <img src="<%= album.photo && album.photo !== 'no-image.png' ? '/uploads/' + album.photo : '/img/placeholder.svg' %>"
                                     alt="<%= album.title %>" onerror="this.onerror=null;this.src='/img/placeholder.svg';">
                            </div>
                            <div class="album-content" style="flex:1;display:flex;flex-direction:column;">
                                <h3 style="font-size:1.05rem;margin-bottom:0.35rem;color:var(--dark);"><%= album.title %></h3>
                                <p class="album-meta" style="font-size:0.8rem;color:var(--text-light);margin-bottom:0.5rem;">
                                    Oleh <strong><%= album.username %></strong> &middot; <%= timeAgo(album.created_at) %>
                                </p>
                                <% if (album.description) { %>
                                    <p style="font-size:0.88rem;color:var(--text-soft);margin-bottom:auto;">
                                        <%= album.description.length > 90 ? album.description.substring(0, 90) + '...' : album.description %>
                                    </p>
                                <% } %>
                                <div class="album-stats-bar">
                                    <span class="stat-pill" title="Jumlah Disukai">❤️ <%= album.like_count || 0 %></span>
                                    <span class="stat-pill" title="Jumlah Komentar">&#128172; <%= album.comment_count || 0 %></span>
                                    <span style="margin-left:auto;color:var(--primary);font-size:0.82rem;font-weight:700;">Buka &rarr;</span>
                                </div>
                            </div>
                        </a>
                    </article>
                    <% }) %>
                </div>
                <div id="noResults" class="empty-state" style="display:none;margin-top:2rem;">
                    <span class="empty-icon">&#128269;</span>
                    <p>Tidak ada album yang sesuai dengan kata kunci pencarian.</p>
                </div>
                <% } else { %>
                <div class="empty-state page-anim">
                    <span class="empty-icon">&#128247;</span>
                    <p>Belum ada album foto yang diunggah.</p>
                    <p style="margin-top:0.75rem;">
                        <% if (locals.user) { %>
                            <a href="/albums/add" class="btn btn-primary btn-sm">Mulai Buat Album Pertama</a>
                        <% } else { %>
                            <a href="/login?r=/albums/add" class="btn btn-primary btn-sm">Masuk untuk Menambah Foto</a>
                        <% } %>
                    </p>
                </div>
                <% } %>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> VinStudio App. Hak cipta dilindungi.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        const searchInput = document.getElementById('albumSearch');
        const container = document.getElementById('albumsContainer');
        const countDisplay = document.getElementById('albumCountDisplay');
        const noResults = document.getElementById('noResults');

        if (searchInput && container) {
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                const cards = container.querySelectorAll('.album-card');
                let visible = 0;
                cards.forEach(card => {
                    const match = !query || card.dataset.title.includes(query);
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (countDisplay) countDisplay.textContent = visible + ' album ditemukan';
                if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
            });
        }
    </script>
</body>
</html>

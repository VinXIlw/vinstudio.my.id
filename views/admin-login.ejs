<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin - VinStudio</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main>
        <section class="auth-page">
            <div class="auth-card">
                <div class="auth-header">
                    <div class="logo">
                        <span class="logo-icon">&#9881;</span>
                        <span class="logo-text">VinStudio Admin</span>
                    </div>
                    <h2>Panel Administrator</h2>
                    <p>Masuk sebagai admin untuk mengelola portal</p>
                </div>

                <% if (msg) { %>
                    <div class="alert alert-info"><%= msg %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <form action="/admin/login" method="POST">
                    <div class="form-group">
                        <label for="email">Email Admin</label>
                        <input type="email" id="email" name="email" required autofocus
                               placeholder="admin@email.com" autocomplete="email">
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" required autocomplete="current-password">
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Masuk sebagai Admin</button>
                </form>

                <p class="auth-footer">
                    <a href="/login">Login sebagai pengguna biasa</a>
                </p>
                <p style="text-align:center; margin-top:1rem;">
                    <a href="/">&larr; Kembali ke Beranda</a>
                </p>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> VinStudio App. Hak cipta dilindungi.</p>
        </div>
    </footer>
</body>
</html>

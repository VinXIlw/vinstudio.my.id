<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Cerita - VinStudio</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">💻</span>
                <span class="logo-text">VinStudio</span>
            </div>
            <%- include('partials/nav', { currentPage: 'stories', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <section class="form-page">
            <div class="container">
                <div class="form-card">
                    <h2>Tambah Cerita Baru</h2>
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-error"><%= error %></div>
                    <% } %>
                    <form action="/stories/add" method="POST">
                        <div class="form-group">
                            <label for="title">Judul Cerita <span class="required">*</span></label>
                            <input type="text" id="title" name="title" required placeholder="Misal: Kegiatan Praktek TKJ">
                        </div>
                        <div class="form-group">
                            <label for="content">Konten Cerita <span class="required">*</span></label>
                            <textarea id="content" name="content" rows="5" required placeholder="Tulis cerita atau pengalamanmu di sini..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Terbitkan Cerita</button>
                    </form>
                    <p style="text-align:center; margin-top:1rem;">
                        <a href="/stories">← Kembali ke Cerita</a>
                    </p>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> TKJ Profile Web App</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
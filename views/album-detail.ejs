<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= album.title %> - Detail Album</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .detail-hero {
            position: relative;
            border-radius: var(--radius-xl);
            overflow: hidden;
            background: #0f172a;
            box-shadow: var(--shadow-lg);
            margin-bottom: 2rem;
            max-height: 540px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .detail-hero img {
            width: 100%;
            height: 100%;
            max-height: 540px;
            object-fit: contain;
            background: #020617;
        }
        .detail-meta-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.75rem 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-sm);
        }
        .detail-header-flex {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1.5rem;
            flex-wrap: wrap;
        }
        .like-bar {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-top: 1.25rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
        }
        .like-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.55rem 1.2rem;
            border-radius: var(--radius-pill);
            border: 1.5px solid var(--border-strong);
            background: var(--white);
            color: var(--text-soft);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all var(--t) var(--ease);
        }
        .like-btn:hover {
            border-color: #f43f5e;
            color: #f43f5e;
            background: #fff1f2;
            transform: scale(1.04);
        }
        .like-btn.liked {
            background: #ffe4e6;
            border-color: #f43f5e;
            color: #e11d48;
        }
        .comments-section {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.75rem 2rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }
        .comment-item {
            display: flex;
            gap: 1rem;
            padding: 1.1rem 0;
            border-bottom: 1px solid var(--border);
        }
        .comment-item:last-child {
            border-bottom: none;
        }
        .comment-content-box {
            flex: 1;
        }
        .comment-author-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.35rem;
        }
        .comment-text {
            color: var(--text-soft);
            line-height: 1.6;
            word-break: break-word;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">&#128248;</span>
                <span class="logo-text">VinStudio</span>
            </div>
            <%- include('partials/nav', { currentPage: 'albums', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <div class="container" style="max-width:960px;">
            <div style="margin-bottom:1.25rem;">
                <a href="/albums" class="btn btn-outline btn-sm">&larr; Kembali ke Semua Album</a>
            </div>

            <% if (msg) { %>
                <div class="alert alert-success"><%= msg %></div>
            <% } %>
            <% if (err) { %>
                <div class="alert alert-error"><%= err %></div>
            <% } %>

            <!-- Preview Foto -->
            <div class="detail-hero page-anim">
                <img src="<%= album.photo && album.photo !== 'no-image.png' ? '/uploads/' + album.photo : '/img/placeholder.svg' %>"
                     alt="<%= album.title %>" onerror="this.onerror=null;this.src='/img/placeholder.svg';">
            </div>

            <!-- Informasi Album -->
            <div class="detail-meta-card page-anim">
                <div class="detail-header-flex">
                    <div>
                        <h1 style="font-size:1.85rem;margin-bottom:0.4rem;color:var(--dark);"><%= album.title %></h1>
                        <div class="user-cell" style="margin-top:0.5rem;">
                            <span class="user-avatar <%= avatarClass(album.username) %>" style="width:34px;height:34px;font-size:0.8rem;">
                                <%= initials(album.username) %>
                            </span>
                            <div class="user-info">
                                <div class="user-name"><%= album.username %></div>
                                <span class="user-email"><%= fmtDateTime(album.created_at) %> (<%= timeAgo(album.created_at) %>)</span>
                            </div>
                        </div>
                    </div>
                    <% if (locals.user && (album.user_id === user.id || user.role === 'admin')) { %>
                        <a href="/albums/delete/<%= album.id %>" class="btn btn-delete btn-sm" onclick="return confirm('Apakah kamu yakin ingin menghapus album ini?')">
                            &#128465; Hapus Album
                        </a>
                    <% } %>
                </div>

                <% if (album.description) { %>
                    <div style="margin-top:1.25rem;font-size:1.02rem;color:var(--text-soft);line-height:1.7;">
                        <%= album.description %>
                    </div>
                <% } %>

                <!-- Tombol Like -->
                <div class="like-bar">
                    <form action="/albums/<%= album.id %>/like" method="POST" class="inline-form">
                        <button type="submit" class="like-btn <%= liked ? 'liked' : '' %>" title="<%= liked ? 'Batal Suka' : 'Sukai Album' %>">
                            <span><%= liked ? '❤️' : '🤍' %></span>
                            <span><%= likeCount %> Suka</span>
                        </button>
                    </form>
                    <span class="admin-hint">&#128172; <%= comments.length %> Komentar</span>
                </div>
            </div>

            <!-- Komentar Section -->
            <div class="comments-section page-anim">
                <h2 style="font-size:1.3rem;margin-bottom:1.25rem;color:var(--dark);display:flex;align-items:center;gap:0.5rem;">
                    &#128172; Komentar (<%= comments.length %>)
                </h2>

                <% if (locals.user) { %>
                    <form action="/albums/<%= album.id %>/comment" method="POST" style="margin-bottom:2rem;">
                        <div class="form-group">
                            <label for="content">Tulis tanggapan atau komentar:</label>
                            <textarea id="content" name="content" rows="3" required placeholder="Tulis komentar kamu di sini..." style="resize:vertical;"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">&#10148; Kirim Komentar</button>
                    </form>
                <% } else { %>
                    <div class="empty-state" style="padding:1.5rem;margin-bottom:1.5rem;">
                        <p>Ingin bergabung dalam obrolan? <a href="/login?r=/albums/<%= album.id %>">Masuk untuk menulis komentar</a></p>
                    </div>
                <% } %>

                <% if (comments.length === 0) { %>
                    <div class="empty-state" style="padding:2rem;">
                        <p class="admin-hint">Belum ada komentar untuk album ini. Jadilah yang pertama memberikan tanggapan!</p>
                    </div>
                <% } else { %>
                    <div class="comments-list">
                        <% comments.forEach(function (c) { %>
                            <div class="comment-item">
                                <span class="user-avatar <%= avatarClass(c.display_name) %>" style="width:38px;height:38px;font-size:0.85rem;flex-shrink:0;">
                                    <%= initials(c.display_name) %>
                                </span>
                                <div class="comment-content-box">
                                    <div class="comment-author-row">
                                        <div>
                                            <strong><%= c.display_name %></strong>
                                            <% if (c.role === 'admin') { %>
                                                <span class="role-badge role-admin" style="font-size:0.65rem;margin-left:0.3rem;">Admin</span>
                                            <% } %>
                                            <small class="admin-hint" style="margin-left:0.5rem;"><%= timeAgo(c.created_at) %></small>
                                        </div>
                                        <% if (locals.user && (c.user_id === user.id || user.role === 'admin')) { %>
                                            <form action="/comments/delete/<%= c.id %>" method="POST" class="inline-form" onsubmit="return confirm('Hapus komentar ini?')">
                                                <input type="hidden" name="return_url" value="/albums/<%= album.id %>">
                                                <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);padding:0.2rem 0.5rem;font-size:0.75rem;">
                                                    &#10005; Hapus
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                    <div class="comment-text"><%= c.content %></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> VinStudio App. Dibuat dengan dedikasi.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>

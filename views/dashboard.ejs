<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Pengguna - VinStudio</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">&#128187;</span>
                <span class="logo-text">VinStudio</span>
            </div>
            <%- include('partials/nav', { currentPage: 'dashboard', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <section class="dashboard-page">
            <div class="container">
                <div class="page-header page-anim">
                    <div>
                        <h1>Halo, <span class="highlight"><%= user.displayName %></span>!</h1>
                        <p class="page-subtitle">Kelola konten dan pengaturan profil akun Anda.</p>
                    </div>
                    <div style="display:flex;gap:0.5rem;">
                        <a href="/albums/add" class="btn btn-primary btn-sm">&#10133; Tambah Album</a>
                        <a href="/stories/add" class="btn btn-outline btn-sm">&#10133; Tulis Cerita</a>
                    </div>
                </div>

                <% if (msg) { %>
                    <div class="alert alert-success"><%= msg %></div>
                <% } %>
                <% if (err) { %>
                    <div class="alert alert-error"><%= err %></div>
                <% } %>

                <section class="dashboard-card page-anim">
                    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;">
                        <span class="user-avatar <%= avatarClass(user.displayName) %>" style="width:52px;height:52px;font-size:1.2rem;">
                            <%= initials(user.displayName) %>
                        </span>
                        <div>
                            <h2 style="font-size:1.25rem;margin-bottom:0.2rem;color:var(--dark);"><%= user.displayName %></h2>
                            <span class="admin-hint">Email: <strong><%= user.email %></strong> &middot; Peran: <strong><%= user.role === 'admin' ? 'Administrator' : 'Anggota' %></strong></span>
                        </div>
                    </div>

                    <form action="/account/name" method="POST" class="name-form" style="max-width:440px;">
                        <div class="form-group">
                            <label for="display_name">Ganti Nama Tampilan</label>
                            <input type="text" id="display_name" name="display_name" maxlength="60"
                                   value="<%= user.displayName %>" required
                                   placeholder="Contoh: Kelvin">
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">&#9999; Simpan Perubahan Nama</button>
                    </form>
                </section>

                <div class="dashboard-stats page-anim">
                    <div class="stat-card">
                        <span class="stat-number"><%= albumCount %></span>
                        <span class="stat-label">Album yang kamu buat</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-number"><%= storyCount %></span>
                        <span class="stat-label">Cerita yang kamu terbitkan</span>
                    </div>
                </div>

                <div class="dashboard-grids page-anim">
                    <!-- Album Saya -->
                    <div class="dashboard-column">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
                            <h2 style="font-size:1.2rem;color:var(--dark);">&#128248; Album Saya</h2>
                            <a href="/albums/add" class="btn btn-outline btn-sm">+ Baru</a>
                        </div>
                        <% if (myAlbums.length > 0) { %>
                            <div class="dashboard-list">
                                <% myAlbums.forEach(a => { %>
                                <article class="list-item">
                                    <div style="min-width:0;flex:1;">
                                        <a href="/albums/<%= a.id %>" style="font-weight:700;color:var(--dark);text-decoration:none;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <%= a.title %>
                                        </a>
                                        <small class="admin-hint"><%= timeAgo(a.created_at) %></small>
                                    </div>
                                    <div style="display:flex;gap:0.4rem;align-items:center;flex-shrink:0;">
                                        <a href="/albums/<%= a.id %>" class="btn btn-outline btn-sm" style="padding:0.3rem 0.6rem;font-size:0.75rem;">Lihat</a>
                                        <a href="/albums/delete/<%= a.id %>" class="btn-delete btn-sm" style="padding:0.3rem 0.6rem;font-size:0.75rem;" onclick="return confirm('Hapus album ini?')">&#128465;</a>
                                    </div>
                                </article>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="empty-state">Belum ada album. <a href="/albums/add">Buat album pertama</a></p>
                        <% } %>
                    </div>

                    <!-- Cerita Saya -->
                    <div class="dashboard-column">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
                            <h2 style="font-size:1.2rem;color:var(--dark);">&#128214; Cerita Saya</h2>
                            <a href="/stories/add" class="btn btn-outline btn-sm">+ Baru</a>
                        </div>
                        <% if (myStories.length > 0) { %>
                            <div class="dashboard-list">
                                <% myStories.forEach(s => { %>
                                <article class="list-item">
                                    <div style="min-width:0;flex:1;">
                                        <a href="/stories/<%= s.id %>" style="font-weight:700;color:var(--dark);text-decoration:none;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <%= s.title %>
                                        </a>
                                        <small class="admin-hint"><%= timeAgo(s.created_at) %></small>
                                    </div>
                                    <div style="display:flex;gap:0.4rem;align-items:center;flex-shrink:0;">
                                        <a href="/stories/<%= s.id %>" class="btn btn-outline btn-sm" style="padding:0.3rem 0.6rem;font-size:0.75rem;">Baca</a>
                                        <a href="/stories/delete/<%= s.id %>" class="btn-delete btn-sm" style="padding:0.3rem 0.6rem;font-size:0.75rem;" onclick="return confirm('Hapus cerita ini?')">&#128465;</a>
                                    </div>
                                </article>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="empty-state">Belum ada cerita. <a href="/stories/add">Tulis cerita pertama</a></p>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> VinStudio App. Hak cipta dilindungi.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>

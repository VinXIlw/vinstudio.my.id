<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beranda - TKJ Connect</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">💻</span>
                <span class="logo-text">TKJ Connect</span>
            </div>
            <%- include('partials/nav', { currentPage: 'home', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <h1>Selamat Datang di <span class="highlight">TKJ Connect</span></h1>
                <p class="hero-subtitle">Portal Profil Kelas Teknik Komputer dan Jaringan</p>
                <div class="hero-stats">
                    <div class="stat"><span class="stat-number"><%= albumCount %></span><span class="stat-label">Album</span></div>
                    <div class="stat"><span class="stat-number"><%= storyCount %></span><span class="stat-label">Cerita</span></div>
                    <div class="stat"><span class="stat-number"><%= profile ? 1 : 0 %></span><span class="stat-label">Profil Kelas</span></div>
                </div>
            </div>
        </section>

        <!-- Quick Stats -->
        <section class="quick-info">
            <div class="container">
                <% if (profile) { %>
                <div class="info-card">
                    <h2>📋 Profil Kelas: <%= profile.class_name %></h2>
                    <p><%= profile.description %></p>
                    <div class="info-grid">
                        <div><strong>Wali Kelas:</strong> <%= profile.teacher_name %></div>
                        <div><strong>Tahun Ajaran:</strong> <%= profile.school_year %></div>
                    </div>
                    <a href="/profile" class="btn btn-primary">Lihat Detail Profil</a>
                </div>
                <% } %>

                <div class="section-header">
                    <h2>Album Terbaru</h2>
                    <a href="/albums" class="btn btn-sm">Lihat Semua</a>
                </div>
                <% if (recentAlbums.length > 0) { %>
                <div class="album-grid">
                    <% recentAlbums.forEach(album => { %>
                    <article class="album-card">
                        <img src="<%= album.photo && album.photo !== 'no-image.png' ? '/uploads/' + album.photo : '/img/placeholder.svg' %>" alt="<%= album.title %>" onerror="this.onerror=null;this.src='/img/placeholder.svg';">
                        <div class="album-content">
                            <h3><%= album.title %></h3>
                            <p class="album-meta">Oleh <%= album.username %> • <%= new Date(album.created_at).toLocaleDateString('id-ID') %></p>
                            <% if (album.description) { %><p><%= album.description.substring(0, 100) %><%= album.description.length > 100 ? '...' : '' %></p><% } %>
                        </div>
                    </article>
                    <% }) %>
                </div>
                <% } else { %>
                <p class="empty-state">Belum ada album. <a href="/login?r=/albums/add">Login untuk menambah album</a></p>
                <% } %>

                <div class="section-header">
                    <h2>Cerita Terbaru</h2>
                    <a href="/stories" class="btn btn-sm">Lihat Semua</a>
                </div>
                <% if (recentStories.length > 0) { %>
                <div class="story-list">
                    <% recentStories.forEach(story => { %>
                    <article class="story-card">
                        <h3><%= story.title %></h3>
                        <p class="story-meta">Oleh <%= story.username %> • <%= new Date(story.created_at).toLocaleDateString('id-ID') %></p>
                        <p><%= story.content.substring(0, 150) %><%= story.content.length > 150 ? '...' : '' %></p>
                    </article>
                    <% }) %>
                </div>
                <% } else { %>
                <p class="empty-state">Belum ada cerita. <a href="/login?r=/stories/add">Login untuk menambah cerita</a></p>
                <% } %>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> TKJ Profile Web App. Dibuat dengan ❤️ untuk kelas Teknik Komputer dan Jaringan.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerita &amp; Artikel - VinStudio</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .story-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .story-card {
            cursor: pointer;
            position: relative;
            transition: all var(--t) var(--ease-out);
            border-left: 4px solid var(--primary);
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .story-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-left-color: var(--secondary);
        }
        .story-footer-bar {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-top: 1rem;
            padding-top: 0.75rem;
            border-top: 1px solid var(--border);
            font-size: 0.8rem;
            color: var(--text-light);
        }
        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            background: var(--lighter);
            border: 1px solid var(--border);
            padding: 0.2rem 0.55rem;
            border-radius: var(--radius-pill);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">&#128214;</span>
                <span class="logo-text">VinStudio</span>
            </div>
            <%- include('partials/nav', { currentPage: 'stories', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <section class="stories-page">
            <div class="container">
                <div class="page-header page-anim">
                    <div>
                        <h1>&#128214; Cerita, Blog &amp; Pengalaman</h1>
                        <p class="page-subtitle">Kumpulan tulisan, catatan praktikum, dan cerita dari komunitas.</p>
                    </div>
                    <% if (locals.user) { %>
                        <a href="/stories/add" class="btn btn-primary">&#10133; Tulis Cerita Baru</a>
                    <% } else { %>
                        <a href="/login?r=/stories/add" class="btn btn-outline">Masuk untuk Menulis Cerita</a>
                    <% } %>
                </div>

                <!-- Toolbar Pencarian -->
                <div class="toolbar page-anim" style="margin-bottom:1.75rem;">
                    <div class="search-box">
                        <span class="search-icon">&#128269;</span>
                        <input type="search" id="storySearch" placeholder="Cari judul atau isi cerita..." aria-label="Cari cerita">
                    </div>
                    <span class="admin-hint" id="storyCountDisplay"><%= stories.length %> cerita diterbitkan</span>
                </div>

                <% if (stories.length > 0) { %>
                <div class="story-grid page-anim" id="storiesContainer">
                    <% stories.forEach(story => { %>
                    <article class="story-card" data-search="<%= (story.title + ' ' + (story.username || '') + ' ' + story.content).toLowerCase() %>">
                        <a href="/stories/<%= story.id %>" class="story-link" style="display:flex;flex-direction:column;height:100%;">
                            <div class="story-header" style="margin-bottom:0.75rem;">
                                <h3 style="font-size:1.15rem;color:var(--dark);margin-bottom:0.35rem;"><%= story.title %></h3>
                                <p class="story-meta" style="font-size:0.8rem;color:var(--text-light);margin-bottom:0;">
                                    Oleh <strong><%= story.username %></strong> &middot; <%= timeAgo(story.created_at) %>
                                </p>
                            </div>
                            <p style="font-size:0.92rem;color:var(--text-soft);line-height:1.65;flex:1;">
                                <%= story.content.length > 180 ? story.content.substring(0, 180) + '...' : story.content %>
                            </p>
                            <div class="story-footer-bar">
                                <span class="stat-pill">❤️ <%= story.like_count || 0 %> Suka</span>
                                <span class="stat-pill">&#128172; <%= story.comment_count || 0 %> Komentar</span>
                                <span style="margin-left:auto;color:var(--primary);font-size:0.85rem;font-weight:700;">Baca Selengkapnya &rarr;</span>
                            </div>
                        </a>
                    </article>
                    <% }) %>
                </div>
                <div id="noStoryResults" class="empty-state" style="display:none;margin-top:2rem;">
                    <span class="empty-icon">&#128269;</span>
                    <p>Tidak ada cerita yang sesuai dengan kata kunci pencarian.</p>
                </div>
                <% } else { %>
                <div class="empty-state page-anim">
                    <span class="empty-icon">&#128221;</span>
                    <p>Belum ada cerita yang dibagikan.</p>
                    <p style="margin-top:0.75rem;">
                        <% if (locals.user) { %>
                            <a href="/stories/add" class="btn btn-primary btn-sm">Bagikan Cerita Pertama</a>
                        <% } else { %>
                            <a href="/login?r=/stories/add" class="btn btn-primary btn-sm">Masuk untuk Menulis</a>
                        <% } %>
                    </p>
                </div>
                <% } %>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> VinStudio App. Hak cipta dilindungi.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        const searchInput = document.getElementById('storySearch');
        const container = document.getElementById('storiesContainer');
        const countDisplay = document.getElementById('storyCountDisplay');
        const noResults = document.getElementById('noStoryResults');

        if (searchInput && container) {
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                const cards = container.querySelectorAll('.story-card');
                let visible = 0;
                cards.forEach(card => {
                    const match = !query || card.dataset.search.includes(query);
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (countDisplay) countDisplay.textContent = visible + ' cerita ditemukan';
                if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
            });
        }
    </script>
</body>
</html>

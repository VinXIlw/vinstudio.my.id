<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akses Ditolak - TKJ Connect</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <span class="logo-icon">&#9881;</span>
                <span class="logo-text">TKJ Connect</span>
            </div>
            <%- include('partials/nav', { currentPage: '', user: locals.user }) %>
            <button class="mobile-menu-btn"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        <section class="profile-detail">
            <div class="container">
                <div class="empty-state">
                    <h1 style="font-size:3rem; margin-bottom:0.5rem;">&#128683;</h1>
                    <h2>Akses Ditolak</h2>
                    <p>Halaman ini hanya bisa diakses oleh akun admin.</p>
                    <p style="margin-top:1rem;">
                        <a href="/admin/login" class="btn btn-primary">Login sebagai Admin</a>
                    </p>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> TKJ Profile Web App</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
